## Copy to .env.local and fill with real values (never commit .env.local)

# Primary pooled connection (Neon recommended) used by Prisma at runtime
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true"

# Direct (unpooled) connection for migrations / long transactions
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Public base (optional). Leave empty for same-origin.
NEXT_PUBLIC_API_BASE=""

# Protect /api/scrape route (add header x-api-key)
SCRAPE_API_KEY="changeme"

# Add other custom vars below
